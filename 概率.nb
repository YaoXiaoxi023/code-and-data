Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "function", " ", "p"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"p", "[", 
     RowBox[{"s_", ",", "\[Theta]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", "2"}], "*", 
     RowBox[{"1", "/", "2"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "2"}], " ", 
           RowBox[{"s", "^", "2"}]}], "]"}]}], ")"}], "+", 
       RowBox[{
        RowBox[{
         RowBox[{"Tan", "[", 
          RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", "2"}], "*", 
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "2"}], " ", 
            RowBox[{"s", "^", "2"}]}], "]"}]}], ")"}]}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "list", " ", "of", " ", "original", " ", "and", 
    " ", "scaled", " ", "s", " ", "values"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sOriginal", "=", 
   RowBox[{"{", 
    RowBox[{"0.1", ",", "0.5", ",", "1", ",", "2"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sList", "=", 
    RowBox[{"1.64", "*", "sOriginal"}]}], ";"}], "   ", 
  RowBox[{"(*", "\:8ba1\:7b97\:65f6\:7528\:653e\:5927\:7684", "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Data", " ", "for", " ", "all", " ", "s", " ", "values"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dataShort", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", 
          RowBox[{"p", "[", 
           RowBox[{"s", ",", "\[Theta]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "0.01", ",", 
          RowBox[{"10", " ", 
           RowBox[{"Pi", "/", "11"}]}], ",", 
          RowBox[{"Pi", "/", "20"}]}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"s", ",", "sList"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Ticks", " ", "for", " ", "the", " ", "\[Theta]", " ", "axis"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"thetaTicks", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", " ", "n", " ", 
         RowBox[{"Pi", "/", "9"}]}], ",", 
        RowBox[{"Row", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", " ", "n"}], ",", "\"\<\[Pi]/9\>\""}], "}"}], "]"}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "0", ",", "6"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Plot", " ", "all", " ", "the", " ", "data", " ", "with", " ", "hollow", 
    " ", "markers"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"plotMain", "=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"dataShort", ",", 
      RowBox[{"Joined", "->", "True"}], ",", 
      RowBox[{"PlotMarkers", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<OpenMarkers\>\"", ",", "Medium"}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"s", "==", 
            RowBox[{"1.64", "*", "2"}]}], ",", "Black", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"s", "==", 
              RowBox[{"1.64", "*", "0.1"}]}], ",", "Red", ",", "Dotted"}], 
            "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "sList"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"PlotTheme", "->", "\"\<Scientific\>\""}], ",", 
      RowBox[{"PlotLegends", "->", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"StringForm", "[", 
            RowBox[{"\"\<s=``\>\"", ",", "#"}], "]"}], "&"}], "/@", 
          "sOriginal"}], ",", 
         RowBox[{"{", 
          RowBox[{"Left", ",", "Bottom"}], "}"}]}], "]"}]}]}], "  ", 
     RowBox[{"(*", 
      RowBox[{
      "\:2705", " ", "\:7528\:539f\:59cb\:6570\:503c\:505a\:56fe\:4f8b"}], 
      "*)"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Show", " ", "the", " ", "plot"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"plotMain", ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
