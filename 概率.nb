        RowBox[{
        "\"\<\[Theta]\>\"", ",", 
         "\"\<\\!\\(\\*SubscriptBox[\\(p\\), \\(b\\)]\\)\>\""}], "}"}]}], ",", 
      RowBox[{"LabelStyle", "->", 
